// 이 파일을 arduino_secrets.h 로 복사한 뒤 값을 채운다.
// arduino_secrets.h 는 .gitignore 에 있어 저장소에 올라가지 않는다.
#pragma once

// UNO R4 WiFi 의 ESP32-S3 는 2.4GHz 만 지원한다. 5GHz SSID 로는 접속되지 않는다.
#define SECRET_WIFI_SSID  "your-2.4GHz-ssid"
#define SECRET_WIFI_PASS  ""        // 개방망이면 빈 문자열

// 이 보드를 몸의 어느 쪽에 다는지. 두 보드에 같은 스케치를 올리고 이 값만 다르게 준다.
//   "left" / "right" : 공통 경보 + 자기 쪽 낙하 경보(safe-vibe/alert/<side>)를 받는다
//   "both"           : 공통 경보만 받는다 (한 대만 쓸 때, 이 줄이 없을 때의 기본값)
#define VIBE_SIDE  "left"
